sap.ui.define([], () => {                                                                                                                                                                                                                                      
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    // Status im Protokoll (ZJMQMS_STRUKLOG-STATUS): S = ok, W = Warnung, E = Fehler                                                                                                                                                                           
    const STATE = { S: "Success", W: "Warning", E: "Error" };                                                                                                                                                                                                  
    const ICON = { S: "sap-icon://message-success", W: "sap-icon://message-warning", E: "sap-icon://message-error" };                                                                                                                                          
                                                                                                                                                                                                                                                               
    return {                                                                                                                                                                                                                                                   
        /** ValueState fuer ObjectStatus; unbekannte oder leere Werte neutral */                                                                                                                                                                               
        statusState(sStatus) {                                                                                                                                                                                                                                 
            return STATE[sStatus] || "None";                                                                                                                                                                                                                   
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        statusIcon(sStatus) {                                                                                                                                                                                                                                  
            return ICON[sStatus] || "";                                                                                                                                                                                                                        
        }                                                                                                                                                                                                                                                      
    };                                                                                                                                                                                                                                                         
});                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               