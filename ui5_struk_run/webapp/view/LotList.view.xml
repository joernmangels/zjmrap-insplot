<mvc:View controllerName="de.enercon.qm009.strukrun.controller.LotList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:svm="sap.ui.comp.smartvariants"
    xmlns="sap.m">
    <f:DynamicPage id="lotListPage" toggleHeaderOnTitleClick="true">
        <!-- Variantenverwaltung als Seitentitel: Varianten sichern, als
             Standard markieren, fuer alle freigeben (Flex-Dienst /sap/bc/lrep) -->
        <f:title>
            <f:DynamicPageTitle id="pageTitle">
                <f:heading>
                    <!-- Kein "Automatisch anwenden": die Liste folgt jeder Variante sofort -->
                    <svm:SmartVariantManagement id="variantManagement"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader id="pageHeader" pinnable="true">
                <!-- Enter in einem Feld oder "Start" startet die Suche. Was in
                     einer Variante landet, bestimmt der Controller (fetchData/applyData) -->
                <fb:FilterBar id="filterBar"
                              persistencyKey="de.enercon.qm009.strukrun.LotList"
                              useToolbar="false"
                              search=".onSearch"
                              afterVariantLoad=".onAfterVariantLoad">
                    <fb:filterGroupItems>
                        <fb:FilterGroupItem id="fgiPrueflos" groupName="lot" name="Prueflos"
                                            label="{i18n>filterPrueflos}" visibleInFilterBar="true">
                            <fb:control>
                                <Input id="prueflosInput" submit=".onSearch" change=".onFilterFieldChange"
                                       showValueHelp="true" valueHelpRequest=".onValueHelp"/>
                            </fb:control>
                        </fb:FilterGroupItem>
                        <fb:FilterGroupItem id="fgiWerk" groupName="lot" name="Werk"
                                            label="{i18n>filterWerk}" visibleInFilterBar="true">
                            <fb:control>
                                <Input id="werkInput" submit=".onSearch" change=".onFilterFieldChange"
                                       showValueHelp="true" valueHelpRequest=".onValueHelp"/>
                            </fb:control>
                        </fb:FilterGroupItem>
                        <fb:FilterGroupItem id="fgiPruefart" groupName="lot" name="Pruefart"
                                            label="{i18n>filterPruefart}" visibleInFilterBar="true">
                            <fb:control>
                                <Input id="pruefartInput" submit=".onSearch" change=".onFilterFieldChange"
                                       showValueHelp="true" valueHelpRequest=".onValueHelp"/>
                            </fb:control>
                        </fb:FilterGroupItem>
                        <fb:FilterGroupItem id="fgiMaterial" groupName="lot" name="Material"
                                            label="{i18n>filterMaterial}" visibleInFilterBar="true">
                            <fb:control>
                                <Input id="materialInput" submit=".onSearch" change=".onFilterFieldChange"
                                       showValueHelp="true" valueHelpRequest=".onValueHelp"/>
                            </fb:control>
                        </fb:FilterGroupItem>
                        <fb:FilterGroupItem id="fgiDatum" groupName="lot" name="Entstehungsdatum"
                                            label="{i18n>filterDatum}" visibleInFilterBar="true">
                            <fb:control>
                                <!-- Relative Zeitraeume ("Letzte 30 Tage") bleiben in der
                                     Variante relativ: gespeichert wird die Regel, nicht das Datum.
                                     LASTDAYSINCLUDED statt LASTDAYS: das schliesst heute ein,
                                     sonst fehlen die heute entstandenen Lose -->
                                <DynamicDateRange id="datumRange" change=".onDateChange"
                                                  standardOptions="DATE,DATERANGE,FROM,TO,TODAY,YESTERDAY,LASTDAYSINCLUDED,THISWEEK,LASTWEEK,THISMONTH,LASTMONTH,THISYEAR"/>
                            </fb:control>
                        </fb:FilterGroupItem>
                        <!-- Weitere Filter: ueber "Filter anpassen" einblendbar -->
                        <fb:FilterGroupItem id="fgiCharge" groupName="lot" name="Charge"
                                            label="{i18n>filterCharge}" visibleInFilterBar="false">
                            <fb:control>
                                <Input id="chargeInput" submit=".onSearch" change=".onFilterFieldChange"/>
                            </fb:control>
                        </fb:FilterGroupItem>
                        <fb:FilterGroupItem id="fgiHerkunft" groupName="lot" name="Herkunft"
                                            label="{i18n>filterHerkunft}" visibleInFilterBar="false">
                            <fb:control>
                                <Input id="herkunftInput" maxLength="2" submit=".onSearch" change=".onFilterFieldChange"/>
                            </fb:control>
                        </fb:FilterGroupItem>
                    </fb:filterGroupItems>
                </fb:FilterBar>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <!-- suspended: erst laden, wenn die Standardvariante angewendet ist,
                 sonst wird die Liste beim Start doppelt gelesen -->
            <Table id="lotTable"
                   mode="SingleSelectLeft"
                   growing="true"
                   growingThreshold="50"
                   noDataText="{i18n>lotListNoData}"
                   selectionChange=".onSelectionChange"
                   updateFinished=".onLotTableUpdated"
                   items="{
                       path: '/Lot',
                       parameters: { $count: true },
                       suspended: true,
                       sorter: { path: 'Prueflos', descending: true }
                   }">
                <headerToolbar>
                    <OverflowToolbar id="actionBar">
                        <Title id="lotTableTitle" text="{i18n>lotTableTitle} ({view>/lotCount})"/>
                        <ToolbarSpacer id="actionSpacer"/>
                        <!-- Nur aktiv, wenn ein Los markiert ist (ein Los je Lauf) -->
                        <Button id="simulateButton" text="{i18n>simulate}" icon="sap-icon://simulate"
                                enabled="{= ${view>/selectedCount} > 0 }" press=".onSimulate"/>
                        <Button id="buildButton" text="{i18n>build}" icon="sap-icon://process" type="Emphasized"
                                enabled="{= ${view>/selectedCount} > 0 }" press=".onBuild"/>
                        <Button id="sortButton" icon="sap-icon://sort" tooltip="{i18n>sortTooltip}"
                                press=".onOpenSortDialog"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column id="colPrueflos"><Text id="hdrPrueflos" text="{i18n>colPrueflos}"/></Column>
                    <Column id="colWerk" width="5rem"><Text id="hdrWerk" text="{i18n>colWerk}"/></Column>
                    <Column id="colPruefart" width="5rem"><Text id="hdrPruefart" text="{i18n>colPruefart}"/></Column>
                    <Column id="colMaterial"><Text id="hdrMaterial" text="{i18n>colMaterial}"/></Column>
                    <Column id="colDatum" minScreenWidth="Tablet" demandPopin="true"><Text id="hdrDatum" text="{i18n>colDatum}"/></Column>
                    <Column id="colMenge" hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text id="hdrMenge" text="{i18n>colMenge}"/></Column>
                </columns>
                <items>
                    <ColumnListItem id="lotItem">
                        <cells>
                            <Text id="cellPrueflos" text="{Prueflos}"/>
                            <Text id="cellWerk" text="{Werk}"/>
                            <Text id="cellPruefart" text="{Pruefart}"/>
                            <ObjectIdentifier id="cellMaterial" title="{Material}" text="{MaterialText}"/>
                            <Text id="cellDatum" text="{Entstehungsdatum}"/>
                            <ObjectNumber id="cellMenge" number="{Losmenge}" unit="{Mengeneinheit}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>
